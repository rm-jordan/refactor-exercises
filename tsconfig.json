{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "exercises/**/*.ts",
    "exercises/**/*.js",
    "exercises-react/**/*.tsx",
    "reference/**/*.ts",
    "reference-react/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
